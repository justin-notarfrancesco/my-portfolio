# Umami Cloud website ID — lives in the Vercel project's env settings (Production), not locally.
# The tracker only renders in production builds, so leave this unset in local dev.
PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Turnstile — gates /api/email, which hands out the contact address.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile (add notar.nyc as hostname),
# then set both in Vercel env settings (Production + Preview). Local dev falls back to Cloudflare's
# always-pass test keys automatically, so leave these unset locally.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
