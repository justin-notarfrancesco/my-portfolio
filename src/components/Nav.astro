---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Work' },
  { href: '/contact', label: 'Contact' },
];

// Normalize the current path to detect the active link (handles trailing slash + nested routes).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<a href="#main" class="skip-link">Skip to content</a>

<!-- Signage band: black, with the thin white stripe across the top of every NYCTA sign. -->
<header class="band" id="top">
  <div class="wrap band__inner">
    <a class="brand" href="/" aria-label="Justin Notarfrancesco, home" data-umami-event="nav-click" data-umami-event-destination="/">
      <img class="brand__bullet" src="/subway/J.svg" alt="" width="40" height="40" />
      <span class="brand__text">
        <span class="brand__name">Justin Notarfrancesco</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="band__nav">
        {
          links.map((l) => (
            <li>
              {isActive(l.href) ? (
                <span class="band__link is-active" aria-current="page">
                  {l.label}
                </span>
              ) : (
                <a class="band__link" href={l.href} data-umami-event="nav-click" data-umami-event-destination={l.href}>
                  {l.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Clipped to nothing until focused, rather than parked above the page
     edge: the overscroll bounce at the top would reveal a parked link, and
     visibility: hidden would take it out of the tab order. */
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    z-index: 100;
    background: var(--mta-yellow);
    color: var(--ink);
    padding: 0.5rem 0.9rem;
    font-weight: 700;
  }
  .skip-link:not(:focus) {
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    padding: 0;
  }

  .band {
    background: var(--ink);
    color: var(--on-ink);
    border-top: 6px solid var(--ink);
  }
  .band::before {
    content: '';
    position: absolute;
    inset: 4px 0 auto;
    height: 2px;
    background: var(--on-ink);
  }
  /* The brand always sits centered in a band-height row, whether the nav
     shares that row (wide) or drops to its own row below (narrow), so the
     name never shifts when the layout switches. */
  .band__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 2rem;
  }
  .band :focus-visible {
    outline-color: var(--mta-yellow);
    outline-offset: -3px;
  }

  .brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: var(--band-h);
  }
  .brand__bullet {
    flex: none;
    transition: transform 0.15s ease;
  }
  @media (hover: hover) {
    .brand:hover .brand__bullet {
      transform: scale(1.06);
    }
  }
  .brand__text {
    min-width: 0;
    overflow-wrap: anywhere;
    display: grid;
    line-height: 1.15;
  }
  .brand__name {
    font-weight: 700;
    font-size: var(--t-body);
    letter-spacing: 0.005em;
  }

  /* Links run the full height of the band, so the selection bar sits on the
     band's bottom edge. The last link's text ends flush with the content
     edge: the list hangs its padding into the gutter. */
  .band nav {
    min-width: 0;
  }
  /* Wraps only when the reader enlarges text far enough that four links
     can't share a row; at default sizes the breakpoint below prevents it. */
  .band__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    list-style: none;
    margin: 0 -0.8rem 0 0;
    padding: 0;
    height: 100%;
  }
  .band__link {
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 44px;
    padding: 3px 0.8rem 0;
    font-weight: 700;
    font-size: var(--t-small);
    /* One selection metaphor: a bar along the bottom. Hover previews it in
       grey; the current page holds it in yellow. A real border, so it
       survives forced-colors mode. */
    border-bottom: 3px solid transparent;
    transition: border-color 0.15s ease;
  }
  @media (hover: hover) {
    a.band__link:hover {
      border-bottom-color: var(--band-dim);
    }
  }
  a.band__link:active {
    border-bottom-color: var(--on-ink);
  }
  .band__link.is-active {
    border-bottom-color: var(--mta-yellow);
  }

  /* One deliberate breakpoint, set above the width where the links would
     otherwise start wrapping on their own (~605px at default text size).
     In em, so it also trips when the reader enlarges text. */
  @media (max-width: 40em) {
    .band__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    /* Same space above the bullet as the one-row band (so the name doesn't
       move at this breakpoint), but only a little below it before the
       menu's divider. The 40px is the bullet's size. */
    .brand {
      align-self: flex-start;
      min-height: 0;
      padding-block: calc((var(--band-h) - 40px) / 2) 0.65rem;
    }
    .band nav {
      border-top: 1px solid var(--band-rule);
    }
    .band__nav {
      justify-content: space-between;
      margin-inline: -0.55rem;
    }
    .band__link {
      min-height: 48px;
      padding-inline: 0.55rem;
    }
  }
</style>
