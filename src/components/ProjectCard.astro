---
import type { CollectionEntry } from 'astro:content';
import LineBadge from './LineBadge.astro';
import Wordmark from './wordmarks/Wordmark.astro';
import { resolveColor } from '../lib/theme';
import { host, smart } from '../lib/project-sections';

interface Props {
  slug: string;
  title: string;
  description: string;
  techStack: string[];
  image?: string;
  liveUrl?: string;
  line?: string;
  lineColor?: string;
  year?: number;
  wordmark?: CollectionEntry<'projects'>['data']['wordmark'];
  /** Figure number printed in the caption, e.g. "1.3". */
  fig: string;
  /** Eagerly load the roundels and screenshot — set for above-the-fold cards. */
  eager?: boolean;
  /** Lay the plate out as a full-width spread: figure left, text right. */
  wide?: boolean;
}

const { slug, title, description, techStack, image, liveUrl, line = '•', lineColor = 'blue', year, wordmark, fig, eager = false, wide = false } = Astro.props;
const accent = resolveColor(lineColor);
const href = `/projects/${slug}`;
---

<!-- A manual plate: framed screenshot with an offset line-color shadow, a
     route stripe, then title, description, and stack. The title link stretches
     over the whole plate. The caption names the address, since the wordmark
     sits just below it. -->
<article class:list={['plate', { 'plate--wide': wide }]} style={`--accent:${accent}`}>
  <figure class="plate__fig">
    <div class="plate__shot">
      {
        image ? (
          <img src={image} alt="" width="2560" height="1600" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        ) : (
          <span class="plate__placeholder">
            <LineBadge label={line} size={56} eager={eager} />
          </span>
        )
      }
    </div>
    <figcaption class="caption"><span class="mono">Fig. {fig}</span> {host(liveUrl) ?? title}</figcaption>
  </figure>

  <div class="plate__body">
    <div class="plate__bar">
      <LineBadge label={line} size={32} eager={eager} />
      <h3 class="plate__title">
        <a class="plate__link" href={href} data-umami-event="project-click" data-umami-event-project={slug}>{wordmark ? <Wordmark name={wordmark} /> : title}</a>
      </h3>
      {year && <span class="plate__year mono">{year}</span>}
    </div>

    <p class="plate__desc">{smart(description)}</p>
    <div class="plate__stack mono dots"><ul aria-label="Stack">{techStack.map((t) => <li>{t}</li>)}</ul></div>
  </div>
</article>

<style>
  .plate {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .plate__shot {
    border: 2px solid var(--ink);
    background: var(--paper-2);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    box-shadow: var(--plate-shadow) var(--plate-shadow) 0 var(--accent);
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .plate__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s var(--ease);
  }
  .plate__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
  }

  .plate__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--hair);
  }
  .plate__bar::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 5px;
    background: var(--accent);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .plate__title {
    min-width: 0;
    flex: 0 1 auto;
    /* Capped by the plate's width so a long wordmark never outgrows it. */
    font-size: min(clamp(1.4rem, 2.4vw, 1.85rem), 9cqi);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  /* Stretch the title link over the whole plate, keeping one real anchor. The
     focus ring moves to the plate, so keyboard focus matches the hover. */
  .plate__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .plate__link:focus-visible {
    outline: none;
  }
  .plate:has(.plate__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 12px;
    border-radius: 2px;
  }
  .plate:has(.plate__link:focus-visible) .plate__bar::after {
    transform: none;
  }
  @media (hover: hover) {
    .plate:hover .plate__shot {
      transform: translate(-3px, -3px);
      box-shadow: calc(var(--plate-shadow) + 3px) calc(var(--plate-shadow) + 3px) 0 var(--accent);
    }
    .plate:hover .plate__shot img {
      transform: scale(1.015);
    }
    .plate:hover .plate__bar::after {
      transform: none;
    }
  }
  .plate:active .plate__shot {
    transform: none;
  }

  .plate__year {
    margin-left: auto;
    font-size: var(--t-small);
    color: var(--dim);
  }
  .plate__desc {
    margin-top: 1rem;
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .plate__stack {
    margin-top: 0.75rem;
    font-size: var(--t-micro);
    color: var(--dim);
  }
  /* Flex-wrap already moves a whole name to the next line; a name only breaks
     inside when it's wider than the line on its own (very large text). */
  .plate__stack li {
    white-space: normal;
  }

  /* An odd plate out spans the row: figure on the left six columns, its text
     on the right six, on the page grid. */
  @media (min-width: 45.01em) {
    .plate--wide {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }
    .plate--wide .plate__fig {
      grid-column: 1 / span 6;
    }
    .plate--wide .plate__body {
      grid-column: 7 / span 6;
    }
    .plate--wide .plate__bar {
      margin-top: 0;
    }
  }

  /* Phones: the (smaller) offset is mirrored as a right margin, so the
     shadow stays inside the gutter. */
  @media (max-width: 45em) {
    .plate__shot {
      margin-right: var(--plate-shadow);
    }
  }
</style>
