---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to an OG image under /public. */
  image?: string;
  imageAlt?: string;
  /** Open Graph object type: 'profile' for about, 'article' for project pages. */
  type?: 'website' | 'profile' | 'article';
  /** id the contact bar appears below once scrolled past; defaults to the nav band. */
  dockSentinel?: string;
}

const {
  title = 'Justin Notarfrancesco | Frontend Engineer',
  description = 'Justin Notarfrancesco is a frontend engineer at JPMorgan Chase who builds search, browse, and detail pages in React and TypeScript.',
  image = '/og.png',
  imageAlt = 'Justin Notarfrancesco, Frontend Engineer. Subway-style sign with N, A, B, and 6 line bullets.',
  type = 'website',
  dockSentinel,
} = Astro.props;

const site = Astro.site ?? new URL('https://notar.nyc');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
// Only the default card has known dimensions; page-supplied images vary.
const ogSize = image === '/og.png' ? { width: 1200, height: 630 } : null;
const fullTitle = title.includes('Notarfrancesco') ? title : `${title} | Justin Notarfrancesco`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/subway/J.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Justin Notarfrancesco" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />

    {
      import.meta.env.PROD && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
          data-domains="notar.nyc"
        />
      )
    }
  </head>
  <body>
    <!-- 12-column construction grid, printed faintly under everything -->
    <div class="guides" aria-hidden="true">
      <div class="wrap g12">{Array.from({ length: 12 }, () => <i></i>)}</div>
    </div>
    <Nav />
    <ContactDock sentinel={dockSentinel} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Scroll reveal. Anything already in view on load shows at once, so a first
  // impression never waits on animation; reduced motion skips it entirely.
  const items = document.querySelectorAll<HTMLElement>('.reveal');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    items.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) {
        el.style.transition = 'none';
        el.classList.add('is-in');
      } else {
        io.observe(el);
      }
    });
  }
</script>

<style>
  main,
  :global(.band),
  :global(.foot) {
    position: relative;
    z-index: 1;
  }
</style>
