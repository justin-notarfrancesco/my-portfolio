---
import Layout from "../layouts/Layout.astro";
import ChapterHead from "../components/ChapterHead.astro";
import LineBadge from "../components/LineBadge.astro";
import SkillsIndex from "../components/SkillsIndex.astro";
import Stats from "../components/Stats.astro";
import { PERSON, SITE_URL } from "../lib/schema";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE_URL}/about#page`,
  url: `${SITE_URL}/about`,
  name: "About Justin Notarfrancesco",
  mainEntity: PERSON,
};
---

<Layout
  title="About"
  description="About Justin Notarfrancesco, a frontend engineer at JPMorgan Chase who likes discovery UX, fast pages, and readable code."
  type="profile"
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(schema)}
  />
  <section class="page">
    <div class="wrap">
      <div class="chapter">
        <span class="chapter__num">1.0</span>
        <span>Profile</span>
      </div>

      <div class="g12">
        <header class="about__head">
          <p class="eyebrow">
            <LineBadge label="A" size={28} title="A for About" eager />
            <span class="mono">STATION GUIDE</span>
          </p>
          <h1 class="page__title">About</h1>
        </header>

        <div class="about__bio">
          <p class="lede">
            I&rsquo;m Justin, a frontend engineer at JPMorgan Chase. I build the
            pages people use to find something and decide on it: browsing,
            filtering, and the detail page that answers their questions. Five
            years in, I&rsquo;ve learned that the edge cases <em>are</em> the
            job.
          </p>
          <p class="about__more">
            <b>That way of working borrows from Massimo Vignelli&rsquo;s 1970 subway
            signage.</b> The best systems disappear into usefulness: good wayfinding,
            honest typography, a strict grid, and color that means something. I care
            about the details a user never consciously notices, the ones that
            make an interface feel effortless.
            I&rsquo;m happiest at the intersection of engineering rigor and
            design craft, translating between the two so a team can move fast
            without breaking the experience.
          </p>
        </div>
      </div>

      <section class="page__section" aria-labelledby="glance-title">
        <ChapterHead num="2.0" title="At a Glance" id="glance-title" />
        <Stats chapter="2" />
      </section>

      <section class="page__section" aria-labelledby="skills-title">
        <ChapterHead num="3.0" title="Skills & Tech Stack" id="skills-title">
          <p class="eyebrow" slot="eyebrow">
            <LineBadge label="G" size={28} title="G for Guide" />
            <span class="mono">SERVICE GUIDE</span>
          </p>
        </ChapterHead>
        <SkillsIndex chapter="3" />
      </section>

      <p class="folio" aria-hidden="true"><span>3.0 &mdash; Skills &amp; Tech Stack</span><span>03</span></p>
    </div>
  </section>
</Layout>

<style>
  /* The title holds columns 1–4 and the bio starts beside it on col 5, so
     the two share a row instead of leaving the left columns empty under the
     title. The bio's hairline lines up with the title's cap height. */
  .about__head {
    grid-column: 1 / span 4;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .about__head .page__title {
    margin-top: 1.1rem;
  }
  .about__bio {
    grid-column: 5 / span 8;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--hair);
  }
  /* Directly under a chapter head, whose rule already closes the top. */
  .page__section :global(.stats) {
    margin-top: 0;
    border-top: 0;
  }
  .about__more {
    margin-top: 1.25rem;
    max-width: 62ch;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (max-width: 62.5em) {
    .about__head,
    .about__bio {
      grid-column: 1 / span 12;
    }
  }
</style>
