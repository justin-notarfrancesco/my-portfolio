---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ChapterHead from '../components/ChapterHead.astro';
import LineBadge from '../components/LineBadge.astro';
import NowArriving from '../components/NowArriving.astro';
import SkillsIndex from '../components/SkillsIndex.astro';
import Stats from '../components/Stats.astro';
import SubwayTrain from '../components/SubwayTrain.astro';
import Wordmark from '../components/wordmarks/Wordmark.astro';
import profile from '../assets/profile.png';
import { GITHUB_URL, LINKEDIN_URL } from '../lib/profile';
import { bullets, host, inline, section, smart } from '../lib/project-sections';
import { resolveColor } from '../lib/theme';
import { PERSON, SITE_URL } from '../lib/schema';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const featuredList = featured.length ? featured : projects.slice(0, 3);
const others = projects.filter((p) => !featuredList.includes(p));

// Each featured project gets a full spread: 3.1, 3.2, … with its write-up's
// "What I built" and "Outcome" quoted verbatim.
const spreads = featuredList.map((p, i) => ({
  p,
  n: `3.${i + 1}`,
  accent: resolveColor(p.data.lineColor),
  built: bullets(section(p.body, 'What I built')),
  outcome: inline(section(p.body, 'Outcome')),
}));

const ext = { target: '_blank', rel: 'me noopener noreferrer' };
const out = { target: '_blank', rel: 'noopener noreferrer' };

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#site`,
      url: SITE_URL,
      name: 'Justin Notarfrancesco',
      description:
        'Portfolio of Justin Notarfrancesco, a frontend engineer at JPMorgan Chase who builds search, browse, and detail pages in React and TypeScript.',
      about: { '@id': PERSON['@id'] },
    },
  ],
};
---

<Layout dockSentinel="hero">
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <!-- 1.0 HERO -->
  <section class="hero" id="hero" aria-labelledby="hero-name">
    <div class="wrap">
      <div class="chapter">
        <span class="chapter__num">1.0</span>
        <span>Introduction</span>
      </div>

      <div class="g12 hero__grid">
        <div class="hero__intro">
          <NowArriving />
          <h1 id="hero-name" class="hero__name">Justin<br />Notarfrancesco</h1>
          <p class="hero__title">Frontend Engineer</p>

          <div class="hero__copy">
            <p class="hero__tagline">Wayfinding for the web.</p>
            <p class="hero__subline">
              Over five years at JPMorgan Chase. I make pages easy to browse, and fast by
              loading less.
            </p>
          </div>

          <div class="hero__foot">
            <ul class="hero__lines" aria-label="Selected technologies">
              <!-- Mnemonic bullets, as in the stats: R React, A (the flagship
                   express) TypeScript, C CSS, and the 4 (the Lexington Avenue
                   express, the system's fastest trunk) for Performance. Mixing
                   in a number also keeps the row from spelling anything. -->
              <li><LineBadge label="R" size={28} eager /> React</li>
              <li><LineBadge label="A" size={28} eager /> TypeScript</li>
              <li><LineBadge label="C" size={28} eager /> HTML/CSS</li>
              <li><LineBadge label="4" size={28} eager /> Performance</li>
            </ul>
          </div>

          <!-- Both personas' first move, side by side: see the work, or reach out. -->
          <div class="hero__cta">
            <a class="btn btn--ink" href="/projects" data-umami-event="cta-click" data-umami-event-destination="/projects">View work <span aria-hidden="true">&rarr;</span></a>
            <a class="btn btn--line" href="/contact" data-umami-event="cta-click" data-umami-event-destination="/contact">Contact</a>
            <a class="btn btn--line" href={LINKEDIN_URL} {...ext} data-umami-event="social-click" data-umami-event-platform="linkedin">LinkedIn <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span></a>
          </div>
        </div>

        <figure class="hero__fig">
          <div class="hero__media">
            <div class="hero__frame">
              <Image src={profile} alt="Portrait of Justin Notarfrancesco" width={480} height={480} densities={[1, 2]} loading="eager" />
            </div>
            <SubwayTrain />
          </div>
          <figcaption class="caption"><span class="mono">Fig. 1.1</span> Justin Notarfrancesco</figcaption>
        </figure>
      </div>
      <p class="folio" aria-hidden="true"><span>1.0 &mdash; Introduction</span><span>01</span></p>
    </div>
  </section>

  <!-- 2.0 AT A GLANCE -->
  <section class="glance" aria-labelledby="glance-title">
    <div class="wrap">
      <ChapterHead num="2.0" title="At a Glance" id="glance-title" />
      <div class="glance__body">
          <p class="lede reveal">
            I&rsquo;m Justin, a frontend engineer at JPMorgan Chase. I build the
            pages people use to find something and decide on it: browsing,
            filtering, and the detail page that answers their questions. Five
            years in, I&rsquo;ve learned that the edge cases <em>are</em> the
            job.
          </p>

          <Stats chapter="2" />

          <div class="reach reveal">
            <span class="reach__label label">Get in touch</span>
            <ul class="reach__links">
              <li><a class="btn btn--ink" href="/contact" data-umami-event="cta-click" data-umami-event-destination="/contact">Contact <span aria-hidden="true">&rarr;</span></a></li>
              <li><a class="btn btn--line" href={LINKEDIN_URL} {...ext} data-umami-event="social-click" data-umami-event-platform="linkedin">LinkedIn <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a class="btn btn--line" href={GITHUB_URL} {...ext} data-umami-event="social-click" data-umami-event-platform="github">GitHub <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span></a></li>
            </ul>
          </div>
      </div>
      <p class="folio" aria-hidden="true"><span>2.0 &mdash; At a Glance</span><span>02</span></p>
    </div>
  </section>

  <!-- 3.0 FEATURED WORK -->
  <section class="work" aria-labelledby="work-title">
    <div class="wrap">
      <ChapterHead
        num="3.0"
        title="Featured Work"
        id="work-title"
        link={{ href: '/projects', label: 'All work', attrs: { 'data-umami-event': 'cta-click', 'data-umami-event-destination': '/projects' } }}
      >
        <p class="eyebrow" slot="eyebrow"><span class="mono">EXPRESS SERVICE</span></p>
      </ChapterHead>

      {
        spreads.map(({ p, n, accent, built, outcome }, i) => (
          <article class:list={['spread', { 'spread--flip': i % 2 === 1 }]} style={`--accent:${accent}`} aria-labelledby={`t-${p.id}`}>
            <div class="spread__bar reveal">
              <span class="spread__num num">{n}</span>
              <LineBadge label={p.data.line} size={36} />
              <h3 class="spread__title" id={`t-${p.id}`}>
                <a href={`/projects/${p.id}`} data-umami-event="project-click" data-umami-event-project={p.id}>
                  {p.data.wordmark ? <Wordmark name={p.data.wordmark} /> : p.data.title}
                </a>
              </h3>
              {p.data.year && <span class="spread__year mono">{p.data.year}</span>}
            </div>

            <div class="g12 spread__grid">
              <figure class="spread__fig reveal">
                <a class="shot" href={`/projects/${p.id}`} tabindex="-1" aria-hidden="true" data-umami-event="project-click" data-umami-event-project={p.id}>
                  {p.data.image && <img src={p.data.image} alt="" width="2560" height="1600" loading="lazy" decoding="async" />}
                </a>
                <figcaption class="caption">
                  <span class="mono">Fig. {n}</span> {p.data.title}
                  {host(p.data.liveUrl) && host(p.data.liveUrl) !== p.data.title && <span class="caption__host mono">{host(p.data.liveUrl)}</span>}
                </figcaption>
              </figure>

              <div class="spread__side reveal">
                <p class="spread__desc">{smart(p.data.description)}</p>

                <dl class="spec">
                  <div>
                    <dt>Stack</dt>
                    <dd class="dots">
                      <ul>{p.data.techStack.map((t) => <li>{t}</li>)}</ul>
                    </dd>
                  </div>
                  {p.data.year && (
                    <div>
                      <dt>Year</dt>
                      <dd class="mono">{p.data.year}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Line</dt>
                    <dd class="spec__line"><i aria-hidden="true" />{p.data.line}</dd>
                  </div>
                </dl>

                <div class="spread__actions">
                  {p.data.liveUrl && (
                    <a class="btn btn--ink" href={p.data.liveUrl} {...out} data-umami-event="project-click" data-umami-event-project={p.id} data-umami-event-target="demo">Live site <span aria-hidden="true">&nearr;</span><span class="sr-only"> for {p.data.title} (opens in new tab)</span></a>
                  )}
                  {p.data.repoUrl && (
                    <a class="btn btn--line" href={p.data.repoUrl} {...out} data-umami-event="project-click" data-umami-event-project={p.id} data-umami-event-target="repo">Source <span aria-hidden="true">&nearr;</span><span class="sr-only"> for {p.data.title} (opens in new tab)</span></a>
                  )}
                  <a class="btn btn--text" href={`/projects/${p.id}`} data-umami-event="project-click" data-umami-event-project={p.id}>Read case study<span class="sr-only">: {p.data.title}</span> <span aria-hidden="true">&rarr;</span></a>
                </div>
              </div>

              {built.length > 0 && (
                <div class="spread__built reveal">
                  <h4 class="kicker"><span class="num">{n}.1</span> What I built</h4>
                  <ol class="built">
                    {built.map((b) => <li set:html={b} />)}
                  </ol>
                </div>
              )}
              {outcome && (
                <div class="spread__outcome reveal">
                  <h4 class="kicker"><span class="num">{n}.2</span> Outcome</h4>
                  <p set:html={outcome} />
                </div>
              )}
            </div>
          </article>
        ))
      }
      <p class="folio" aria-hidden="true"><span>3.0 &mdash; Featured Work</span><span>03</span></p>
    </div>
  </section>

  <!-- 4.0 MORE WORK -->
  {
    others.length > 0 && (
      <section class="more" aria-labelledby="more-title">
        <div class="wrap">
          <ChapterHead num="4.0" title="More Work" id="more-title" />
            <ol class="more__list">
              {others.map((p, i) => (
                <li class="row reveal" style={`--accent:${resolveColor(p.data.lineColor)}`}>
                  <span class="row__num num">4.{i + 1}</span>
                  <div class="row__main">
                    <div class="row__head">
                      <LineBadge label={p.data.line} size={28} />
                      <h3 class="row__title">
                        <a href={`/projects/${p.id}`} data-umami-event="project-click" data-umami-event-project={p.id}>
                          {p.data.wordmark ? <Wordmark name={p.data.wordmark} /> : p.data.title}
                        </a>
                      </h3>
                    </div>
                    <p class="row__desc">{smart(p.data.description)}</p>
                    <div class="row__stack mono dots"><ul>{p.data.techStack.map((t) => <li>{t}</li>)}</ul></div>
                  </div>
                  <div class="row__meta">
                    {p.data.year && <span class="mono">{p.data.year}</span>}
                    <span class="row__links">
                      {p.data.liveUrl && (
                        <a class="link" href={p.data.liveUrl} {...out} data-umami-event="project-click" data-umami-event-project={p.id} data-umami-event-target="demo">Live site <span aria-hidden="true">&nearr;</span><span class="sr-only"> for {p.data.title} (opens in new tab)</span></a>
                      )}
                      {p.data.repoUrl && (
                        <a class="link" href={p.data.repoUrl} {...out} data-umami-event="project-click" data-umami-event-project={p.id} data-umami-event-target="repo">Source <span aria-hidden="true">&nearr;</span><span class="sr-only"> for {p.data.title} (opens in new tab)</span></a>
                      )}
                    </span>
                  </div>
                </li>
              ))}
            </ol>
          <p class="folio" aria-hidden="true"><span>4.0 &mdash; More Work</span><span>04</span></p>
        </div>
      </section>
    )
  }

  <!-- 5.0 SKILLS INDEX -->
  <section class="index" aria-labelledby="skills-title">
    <div class="wrap">
      <ChapterHead num="5.0" title="Skills & Tech Stack" id="skills-title" />
      <SkillsIndex chapter="5" />
      <p class="folio" aria-hidden="true"><span>5.0 &mdash; Skills &amp; Tech Stack</span><span>05</span></p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- 1.0 Hero ---------- */
  .hero {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }
  .hero__grid {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  /* The intro adopts the page's columns, so the copy block's measure ends on
     a column line instead of at an arbitrary rem width. */
  .hero__intro {
    grid-column: 1 / span 7;
    display: grid;
    grid-template-columns: subgrid;
  }
  /* :global so child components (Now Arriving) are placed too. */
  .hero__intro > :global(*) {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .hero__name {
    margin-top: 1.1rem;
    /* The floor tracks the viewport too, so a reader's larger default text
       can't push the surname past a phone's edge. */
    font-size: clamp(min(2.35rem, 11vw), 7.4vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .hero__title {
    justify-self: start;
    margin-top: 1.1rem;
    padding: 0.4rem 0.6rem;
    background: var(--ink);
    color: var(--on-ink);
    font-size: var(--t-small);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    font-weight: 700;
  }
  .hero__copy {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--hair);
  }
  .hero__intro > .hero__copy {
    grid-column: 1 / span 6;
  }
  .hero__tagline {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .hero__subline {
    margin-top: 0.8rem;
    font-size: var(--t-body);
    color: var(--dim);
    text-wrap: pretty;
  }
  .hero__foot {
    margin-top: 2rem;
  }
  .hero__cta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .hero__lines {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.6rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__lines li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: var(--t-small);
  }
  .hero__fig {
    grid-column: 9 / span 4;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .hero__media {
    position: relative;
    /* Station markers + frame read as a subway-map line: black ring, white fill. */
    --color-rule: var(--ink);
  }
  .hero__frame {
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
  }
  .hero__frame img {
    width: 100%;
    height: auto;
  }
  /* The train rides ~19px outside the frame; the caption clears it. */
  .hero__fig .caption {
    margin-top: calc(var(--cap-gap) + 0.5rem);
  }

  /* ---------- 2.0 At a Glance ---------- */
  .glance {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 2px solid var(--ink);
    background: var(--paper-2);
  }
  .reach {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem 1.5rem;
  }
  .reach__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---------- 3.0 Featured Work ---------- */
  .work {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 2px solid var(--ink);
  }
  .spread {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .spread:first-of-type {
    padding-top: 0;
  }
  .spread:last-of-type {
    padding-bottom: 0;
  }
  .spread + .spread {
    border-top: 1px solid var(--hair);
  }
  .spread__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 1rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    position: relative;
    border-bottom: 1px solid var(--hair);
  }
  /* The project's line color, drawn as a thick route stripe under its name. */
  .spread__bar::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 6px;
    background: var(--accent);
    transform-origin: left;
  }
  .spread__title {
    min-width: 0;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .spread__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
    padding-bottom: 0.08em;
  }
  .spread__title a:hover,
  .spread__title a:focus-visible {
    background-size: 100% 2px;
  }
  .spread__year {
    flex: none;
    margin-left: auto;
    font-size: var(--t-small);
    color: var(--dim);
  }

  .spread__grid {
    row-gap: clamp(1.75rem, 4vw, 2.75rem);
  }
  .spread__fig {
    grid-column: 1 / span 8;
  }
  .spread__side {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  /* Flipped spreads swap only the figure and its side panel; the write-up
     below keeps reading left to right: what was built, then the outcome. */
  .spread--flip .spread__fig {
    grid-column: 5 / span 8;
    grid-row: 1;
  }
  .spread--flip .spread__side {
    grid-column: 1 / span 4;
    grid-row: 1;
  }
  .shot {
    display: block;
    border: 2px solid var(--ink);
    background: var(--paper-2);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    box-shadow: var(--plate-shadow) var(--plate-shadow) 0 var(--accent);
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s var(--ease);
  }
  @media (hover: hover) {
    .shot:hover {
      transform: translate(-3px, -3px);
      box-shadow: calc(var(--plate-shadow) + 3px) calc(var(--plate-shadow) + 3px) 0 var(--accent);
    }
    .shot:hover img {
      transform: scale(1.015);
    }
  }
  .spread__desc {
    max-width: 60ch;
    font-size: var(--t-body);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .spec {
    border-top: 2px solid var(--ink);
  }
  .spec > div {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hair);
    font-size: var(--t-small);
  }
  .spec dt {
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    font-weight: 700;
    color: var(--dim);
    padding-top: 0.15rem;
  }
  .spec__line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .spec__line i {
    width: 1.75rem;
    height: 6px;
    background: var(--accent);
  }
  /* Buttons share one row; the case-study link always gets its own line, so
     every spread's actions read the same whether it has one button or two. */
  .spread__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  .spread__actions .btn--text {
    flex-basis: 100%;
    min-height: 2.75rem;
  }

  .spread__built {
    grid-column: 1 / span 8;
  }
  .spread__outcome {
    grid-column: 9 / span 4;
  }
  .built {
    counter-reset: b;
    columns: 2;
    column-gap: var(--col-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .built li {
    counter-increment: b;
    break-inside: avoid;
    position: relative;
    padding: 0 0 1rem 2.1rem;
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .built li::before {
    content: counter(b, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.12rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--ink);
    border-top: 3px solid var(--accent);
    padding-top: 0.15rem;
  }
  .spread__outcome p {
    max-width: 68ch;
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---------- 4.0 More Work / 5.0 Skills ---------- */
  .more,
  .index {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 2px solid var(--ink);
  }
  .more__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Rows sit on the page's columns: number in column 1, the entry from
     column 2, and the year and links in the last two. */
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 0.75rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hair);
    position: relative;
  }
  .row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2px;
    height: 2px;
    width: 0;
    background: var(--accent);
    transition: width 0.4s var(--ease);
  }
  .row:hover::before,
  .row:focus-within::before {
    width: 100%;
  }
  .row__num {
    grid-column: 1;
    /* Centred on the 28px badge beside it. */
    line-height: 28px;
  }
  .row__main {
    grid-column: 2 / span 8;
    min-width: 0;
  }
