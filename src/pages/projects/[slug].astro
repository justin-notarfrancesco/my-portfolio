---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LineBadge from '../../components/LineBadge.astro';
import Wordmark from '../../components/wordmarks/Wordmark.astro';
import { resolveColor } from '../../lib/theme';
import { host, smart } from '../../lib/project-sections';
import { LINKEDIN_URL } from '../../lib/profile';
import { PERSON_REF, SITE_URL } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const accent = resolveColor(data.lineColor);

// The stops either side on the line (wrapping at the ends), so a case study
// never dead-ends. Its place on the line is also its figure number on /projects.
const line = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const at = line.findIndex((p) => p.id === project.id);
const prev = line[(at - 1 + line.length) % line.length];
const next = line[(at + 1) % line.length];
const num = `1.${at + 1}`;
const liveHost = host(data.liveUrl);
const firstSentence = smart(data.description).split(/(?<=\.)\s/)[0];
const stops = [
  { dir: 'prev', label: 'Previous stop', p: prev },
  { dir: 'next', label: 'Next stop', p: next },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': `${SITE_URL}/projects/${project.id}#code`,
  name: data.title,
  description: data.description,
  url: `${SITE_URL}/projects/${project.id}`,
  ...(data.repoUrl && { codeRepository: data.repoUrl }),
  ...(data.liveUrl && { sameAs: data.liveUrl }),
  ...(data.image && { image: new URL(data.image, SITE_URL).href }),
  ...(data.year && { dateCreated: String(data.year) }),
  keywords: data.techStack.join(', '),
  author: PERSON_REF,
};
---

<Layout title={data.title} description={data.description} type="article" {...(data.image && { image: data.image, imageAlt: `${data.title} screenshot` })}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />
  <article class="page" style={`--accent:${accent};--num:'${num}'`}>
    <div class="wrap">
      <div class="chapter">
        <a class="back" href="/projects"><span aria-hidden="true">&larr;</span> All work</a>
        <span class="chapter__case"><span class="chapter__num">{num}</span> Case study</span>
      </div>

      <header class="detail__head">
        <div class="detail__bar">
          <LineBadge label={data.line} size={56} eager class="detail__badge" />
          <h1 class="detail__title">{data.wordmark ? <Wordmark name={data.wordmark} /> : data.title}</h1>
          {data.year && <span class="detail__year mono">{data.year}</span>}
        </div>

        <div class="g12 detail__intro">
          <p class="detail__desc">{smart(data.description)}</p>
          <div class="detail__actions">
            {data.liveUrl && (
              <a
                class="btn btn--ink"
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="project-click"
                data-umami-event-project={project.id}
                data-umami-event-target="demo"
              >
                Live site<span class="sr-only"> for {data.title}</span> <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
            {data.repoUrl && (
              <a
                class="btn btn--line"
                href={data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="project-click"
                data-umami-event-project={project.id}
                data-umami-event-target="repo"
              >
                Source<span class="sr-only"> for {data.title}</span> <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
          </div>
        </div>
      </header>

      <figure class="detail__fig">
        <div class="detail__shot">
          {
            data.image ? (
              <img src={data.image} alt={`Screenshot of ${data.title}. ${firstSentence}`} width="2560" height="1600" />
            ) : (
              <div class="detail__placeholder">
                <LineBadge label={data.line} size={72} eager />
              </div>
            )
          }
        </div>
        <figcaption class="caption">
          <span class="mono">Fig. {num}</span> {liveHost === data.title ? 'Live site' : data.title}
          {liveHost && <span class="caption__host mono">{liveHost}</span>}
        </figcaption>
      </figure>

      <div class="g12 detail__layout">
        <div class="prose">
          <Content />
        </div>
        <aside class="detail__aside" aria-labelledby="spec-title">
          <p class="aside__head" id="spec-title"><span class="num">{num}.0</span> Spec</p>
          <dl class="spec">
            <div>
              <dt>Stack</dt>
              <dd class="dots">
                <ul>
                  {data.techStack.map((t) => <li>{t}</li>)}
                </ul>
              </dd>
            </div>
            {data.liveUrl && (
              <div>
                <dt>Live</dt>
                <dd><a class="spec__link" href={data.liveUrl} target="_blank" rel="noopener noreferrer" data-umami-event="project-click" data-umami-event-project={project.id} data-umami-event-target="demo">{liveHost}<span class="sr-only"> (opens in new tab)</span></a></dd>
              </div>
            )}
          </dl>
        </aside>
      </div>

      <nav class="onward" aria-label="More stops on the line">
        <div class="g12 onward__stops">
          {stops.map(({ dir, label, p: s }) => (
            <a class={`onward__stop onward__stop--${dir}`} href={`/projects/${s.id}`} rel={dir} style={`--next:${resolveColor(s.data.lineColor)}`} data-umami-event="project-click" data-umami-event-project={s.id}>
              <span class="onward__label">{label}</span>
              <span class="onward__row">
                {dir === 'prev' && <span class="onward__arrow" aria-hidden="true">&larr;</span>}
                <LineBadge label={s.data.line} size={40} />
                <span class="onward__title">{s.data.wordmark ? <Wordmark name={s.data.wordmark} /> : s.data.title}</span>
                {dir === 'next' && <span class="onward__arrow" aria-hidden="true">&rarr;</span>}
              </span>
            </a>
          ))}
        </div>
        <div class="onward__contact">
          <span class="onward__label">Get in touch</span>
          <div class="onward__actions">
            <a class="btn btn--ink" href="/contact" data-umami-event="cta-click" data-umami-event-destination="/contact">Contact <span aria-hidden="true">&rarr;</span></a>
            <a class="btn btn--line" href={LINKEDIN_URL} target="_blank" rel="me noopener noreferrer" data-umami-event="social-click" data-umami-event-platform="linkedin">LinkedIn <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in new tab)</span></a>
          </div>
        </div>
      </nav>

      <p class="folio" aria-hidden="true"><span>{num} &mdash; {data.title}</span><span>01</span></p>
    </div>
  </article>
</Layout>

<style>
  .chapter {
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    row-gap: 0;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-block: -0.5rem;
  }
  .back:hover,
  .back:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .chapter__case {
    display: inline-flex;
    align-items: baseline;
    gap: 0.9rem;
    color: var(--dim);
  }

  .detail__head {
    container-type: inline-size;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .detail__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hair);
  }
  /* The project's line color, drawn as a thick route stripe under its name. */
  .detail__bar::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 8px;
    background: var(--accent);
  }
  .detail__title {
    min-width: 0;
    /* Capped by the column so a one-line wordmark never outgrows it, even
       with enlarged text. */
    font-size: min(clamp(2.35rem, 7vw, 5.5rem), 12cqi);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .detail__year {
    margin-left: auto;
    font-size: var(--t-small);
    color: var(--dim);
  }
  .detail__intro {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    align-items: end;
    row-gap: 1.5rem;
  }
  .detail__desc {
    grid-column: 1 / span 8;
    max-width: 34em;
    font-size: var(--t-lede);
    line-height: 1.42;
    text-wrap: pretty;
  }
  .detail__actions {
    grid-column: 9 / span 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  .detail__fig {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .detail__shot {
    border: 2px solid var(--ink);
    background: var(--paper-2);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    box-shadow: var(--plate-shadow) var(--plate-shadow) 0 var(--accent);
  }
  .detail__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* A long address breaks only when it can't fit on a line of its own. */
  .detail__fig .caption__host {
    flex: 0 1 auto;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .detail__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
  }

  .detail__layout {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
    row-gap: 2.5rem;
  }
  .prose {
    grid-column: 1 / span 8;
    min-width: 0;
  }
  .detail__aside {
    grid-column: 9 / span 4;
    position: sticky;
    top: 1.5rem;
  }
  /* Set exactly like a write-up section head, so the two rules line up. */
  .aside__head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    font-size: var(--t-micro);
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }
  .spec > div {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hair);
    font-size: var(--t-small);
  }
  .spec dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Flex-wrap already moves a whole name to the next line; a name only breaks
     inside when it's wider than the narrow rail on its own (very large text). */
  .spec dd li {
    white-space: normal;
  }
  .spec dt {
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    font-weight: 700;
    color: var(--dim);
    padding-top: 0.15em;
  }
  .spec__link {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .spec__link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  /* ---------- Onward: previous and next stop, then contact ---------- */
  .onward {
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 2px solid var(--ink);
  }
  .onward__stops {
    row-gap: 1.5rem;
  }
  .onward__label {
    display: block;
    padding-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--dim);
  }
  .onward__stop {
    container-type: inline-size;
    position: relative;
    grid-column: span 6;
    min-width: 0;
  }
  .onward__stop--next {
    text-align: right;
  }
  .onward__row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hair);
  }
  .onward__stop--next .onward__row {
    justify-content: flex-end;
  }
  /* The stop's line color draws in under it on hover and focus. */
  .onward__row::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 5px;
    background: var(--next);
    transform: scaleX(0.15);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .onward__stop--next .onward__row::after {
    transform-origin: right;
  }
  .onward__stop:focus-visible .onward__row::after {
    transform: none;
  }
  .onward__title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: min(clamp(1.25rem, 3vw, 2.25rem), 8cqi);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .onward__arrow {
    flex-shrink: 0;
    font-size: 1.6rem;
    line-height: 1;
    transition: transform 0.3s var(--ease);
  }
  @media (hover: hover) {
    .onward__stop:hover .onward__row::after {
      transform: none;
    }
    .onward__stop--next:hover .onward__arrow {
      transform: translateX(6px);
    }
    .onward__stop--prev:hover .onward__arrow {
      transform: translateX(-6px);
    }
  }
  .onward__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  .onward__contact .onward__label {
    padding-top: 0;
  }
  .onward__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 53.75em) {
    .detail__desc,
    .detail__actions,
    .prose,
    .detail__aside {
      grid-column: 1 / span 12;
    }
    .detail__actions {
      justify-content: flex-start;
    }
    .detail__aside {
      position: static;
      grid-row: 1;
    }
  }
  @media (max-width: 45em) {
    /* Stops stack, each reading left to right with its arrow. */
    .onward__stop {
      grid-column: 1 / -1;
    }
    .onward__stop--next {
      text-align: left;
    }
    .onward__stop--next .onward__row {
      justify-content: flex-start;
    }
    .onward__stop--next .onward__arrow {
      margin-left: auto;
    }
    .onward__stop--next .onward__row::after {
      transform-origin: left;
    }
    /* The (smaller) offset is mirrored as a right margin, keeping the shadow inside the gutter. */
    .detail__shot {
      margin-right: var(--plate-shadow);
    }
  }
  @media (max-width: 32.5em) {
    /* The year steps under the name, so a long wordmark keeps one line. */
    .detail__bar {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .detail__bar :global(.detail__badge) {
      width: 40px;
      height: 40px;
    }
    .detail__title {
      flex: 1 1 0;
      font-size: min(clamp(1.6rem, 8.2vw, 2.35rem), 12cqi);
    }
    .detail__year {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>

<style is:global>
  /* Write-up body: numbered like the manual. Each ## becomes a chapter rule. */
  .prose {
    counter-reset: h2;
  }
  .prose h2 {
    counter-increment: h2;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    font-size: var(--t-micro);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  /* A section with nothing written yet (its heading followed straight by the
     next heading, or ending the write-up) stays hidden. The scaffolded
     sections in src/content/projects/*.md hold only an HTML comment of
     prompts, which doesn't count as content. Hidden headings also skip the
     section counter, so the visible numbering stays 1.0, 2.0, 3.0. */
  .prose h2:has(+ h2),
  .prose h2:last-child {
    display: none;
  }
  /* Numbered under the project's own figure number: 1.3.1, 1.3.2 … */
  .prose h2::before {
    content: var(--num, '1') '.' counter(h2);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .prose h3 {
    margin: 1.5rem 0 0.75rem;
  }
  .prose p,
  .prose li {
    max-width: 66ch;
  }
  .prose p {
    margin-bottom: 1rem;
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .prose ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    counter-reset: li;
  }
  .prose li {
    counter-increment: li;
    position: relative;
    padding: 0 0 0.9rem 2.4rem;
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .prose li::before {
    content: counter(li, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15rem;
    padding-top: 0.15rem;
    border-top: 3px solid var(--accent, var(--ink));
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--ink);
  }
  .prose a {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent, var(--ink));
  }
</style>
